--- !u!114 &6607123903727488037
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4472461876315561075}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c026a262d1d40cf4599ef4d04dc65854, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManagerrr
  subtitleText: {fileID: 3149243968907912439}
  steps:
  - subtitle: "Bienvenido. Est\xE1s en el \xE1rea de revisi\xF3n de equipaje de un
      aeropuerto."
    voiceClip: {fileID: 8300000, guid: 3fd48da44e11c294da2e41e8ee21f63a, type: 3}
    requiresAction: 0
    expectedActionId: 0
    autoAdvanceDelay: 1
    indicator: {fileID: 0}
    lightIndicator: {fileID: 0}
    allowMovement: 0
    allowDecisionInput: 0
    playRetryOnce: 0
    retryAfterSeconds: 0
    retrySubtitle: 
    retryClip: {fileID: 0}
    playWrongActionFeedback: 1
    wrongActionCooldown: 1.25
    wrongActionSubtitle: 
    wrongActionClip: {fileID: 0}
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - subtitle: "Mira a tu alrededor. Frente a ti se encuentra la estaci\xF3n donde
      revisar\xE1s el contenido de las maletas."
    voiceClip: {fileID: 8300000, guid: a79d3d221b3cf294183f078bfbd2a55f, type: 3}
    requiresAction: 0
    expectedActionId: 0
    autoAdvanceDelay: 1
    indicator: {fileID: 0}
    lightIndicator: {fileID: 0}
    allowMovement: 0
    allowDecisionInput: 0
    playRetryOnce: 0
    retryAfterSeconds: 0
    retrySubtitle: 
    retryClip: {fileID: 0}
    playWrongActionFeedback: 1
    wrongActionCooldown: 1.25
    wrongActionSubtitle: 
    wrongActionClip: {fileID: 0}
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - subtitle: "Usa el joystick izquierdo para desplazarte por el espacio. Ac\xE9rcate
      ahora a la banda transportadora se\xF1alada."
    voiceClip: {fileID: 8300000, guid: f0d0930e0b9ad2f4c8a23067b621b569, type: 3}
    requiresAction: 1
    expectedActionId: 1
    autoAdvanceDelay: 0
    indicator: {fileID: 0}
    lightIndicator: {fileID: 2699821300585316568}
    allowMovement: 1
    allowDecisionInput: 0
    playRetryOnce: 1
    retryAfterSeconds: 8
    retrySubtitle: "Intenta de nuevo. Avanza hasta la banda transportadora se\xF1alada."
    retryClip: {fileID: 8300000, guid: d08825f7f534cb24db42bca1abe8e415, type: 3}
    playWrongActionFeedback: 1
    wrongActionCooldown: 1.25
    wrongActionSubtitle: "Intenta de nuevo. Avanza hasta la banda transportadora
      se\xF1alada."
    wrongActionClip: {fileID: 8300000, guid: d08825f7f534cb24db42bca1abe8e415, type: 3}
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - subtitle: "A partir de este momento asumir\xE1s el papel de un operador de revisi\xF3n
      por rayos X."
    voiceClip: {fileID: 8300000, guid: 8497dcd3428e7e9498a49ad6c99ccd8f, type: 3}
    requiresAction: 0
    expectedActionId: 0
    autoAdvanceDelay: 1
    indicator: {fileID: 0}
    lightIndicator: {fileID: 0}
    allowMovement: 0
    allowDecisionInput: 0
    playRetryOnce: 0
    retryAfterSeconds: 0
    retrySubtitle: 
    retryClip: {fileID: 0}
    playWrongActionFeedback: 1
    wrongActionCooldown: 1.25
    wrongActionSubtitle: 
    wrongActionClip: {fileID: 0}
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - subtitle: Tu labor es observar el interior de cada maleta, reconocer los objetos
      que transporta y decidir si el pasajero puede continuar o debe ser detenido.
    voiceClip: {fileID: 8300000, guid: b0dad2b57fc700145b56cae3352498d0, type: 3}
    requiresAction: 0
    expectedActionId: 0
    autoAdvanceDelay: 1
    indicator: {fileID: 959105257}
    lightIndicator: {fileID: 146920181}
    allowMovement: 0
    allowDecisionInput: 0
    playRetryOnce: 0
    retryAfterSeconds: 0
    retrySubtitle: 
    retryClip: {fileID: 0}
    playWrongActionFeedback: 1
    wrongActionCooldown: 1.25
    wrongActionSubtitle: 
    wrongActionClip: {fileID: 0}
    onStepStarted:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 428182654}
          m_TargetAssemblyTypeName: TutorialConveyorStarter, Assembly-CSharp
          m_MethodName: IniciarBandaTutorial
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    onStepCompleted:
      m_PersistentCalls:
        m_Calls: []
  - subtitle: "Debes tomar cada decisi\xF3n antes de que se agote el tiempo. La barra
      que ves en pantalla indica cu\xE1nto tiempo te queda."
    voiceClip: {fileID: 8300000, guid: 958041f64cab1ec47a4ddda2895db0f0, type: 3}
    requiresAction: 0
    expectedActionId: 0
    autoAdvanceDelay: 1
    indicator: {fileID: 564848666}
